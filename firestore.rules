rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function directorPath(uid) {
      return /databases/$(database)/documents/directors/$(uid);
    }

    function documentEventPath(eventId) {
      return /databases/$(database)/documents/documentEvents/$(eventId);
    }

    function hasDirectorRecord(uid) {
      return signedIn() && exists(directorPath(uid));
    }

    function currentDirector() {
      return get(directorPath(request.auth.uid)).data;
    }

    function activeDirector() {
      return hasDirectorRecord(request.auth.uid)
        && currentDirector().accountStatus == 'active';
    }

    function founderDirector() {
      return activeDirector()
        && currentDirector().systemRole == 'founder_director'
        && currentDirector().root == true;
    }

    function hasCapability(capability) {
      return founderDirector()
        || (
          activeDirector()
          && currentDirector().permissions is list
          && currentDirector().permissions.hasAny(['*', capability])
        );
    }

    function isOfficer() {
      return activeDirector() && currentDirector().officerRole != null;
    }

    function selfMayReadDirector(directorId) {
      return signedIn()
        && request.auth.uid == directorId
        && resource.data.accountStatus in ['awaiting_activation', 'active', 'pin_reset_required'];
    }

    function founderMayCreateDirector() {
      return founderDirector()
        && request.resource.data.root == false
        && request.resource.data.systemRole == 'director'
        && request.resource.data.accountStatus == 'awaiting_activation'
        && request.resource.data.directorNumber is string
        && request.resource.data.fullName is string
        && request.resource.data.normalizedName is string
        && request.resource.data.loginKey is string
        && request.resource.data.permissions is list;
    }

    function founderMayUpdateOrdinaryDirector() {
      return founderDirector()
        && resource.data.root != true
        && request.resource.data.root == false
        && request.resource.data.systemRole != 'founder_director'
        && request.resource.data.directorNumber == resource.data.directorNumber
        && request.resource.data.loginKey == resource.data.loginKey
        && request.resource.data.normalizedName == resource.data.normalizedName;
    }

    function selfMayCompleteActivation(directorId) {
      return signedIn()
        && request.auth.uid == directorId
        && resource.data.accountStatus in ['awaiting_activation', 'pin_reset_required']
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'accountStatus', 'activationCompletedAt', 'updatedAt', 'updatedBy'
        ]);
    }

    match /directors/{directorId} {
      allow get: if founderDirector() || selfMayReadDirector(directorId);
      allow list: if founderDirector();
      allow create: if founderMayCreateDirector();
      allow update: if founderMayUpdateOrdinaryDirector() || selfMayCompleteActivation(directorId);
      allow delete: if false;
    }

    match /boardDirectory/{directorId} {
      allow get, list: if founderDirector()
        || (hasCapability('directors.view') && resource.data.directoryVisible == true);
      allow create, update: if founderDirector()
        && request.resource.data.directorNumber is string
        && request.resource.data.fullName is string
        && request.resource.data.boardStatus in ['interim', 'confirmed', 'leave_of_absence', 'former'];
      allow delete: if false;
    }

    match /loginDirectory/{loginKey} {
      allow get: if true;
      allow list: if false;
      allow create: if founderDirector()
        && request.resource.data.directorUid is string
        && request.resource.data.authEmail is string
        && request.resource.data.activationRequired == true;
      allow update: if founderDirector()
        || (
          signedIn()
          && resource.data.directorUid == request.auth.uid
          && request.resource.data.directorUid == resource.data.directorUid
          && request.resource.data.authEmail == resource.data.authEmail
          && resource.data.activationRequired == true
          && request.resource.data.activationRequired == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'activationRequired', 'activatedAt', 'updatedAt'
          ])
        );
      allow delete: if false;
    }

    match /announcements/{noticeId} {
      allow get, list: if hasCapability('announcements.manage')
        || (activeDirector() && resource.data.status == 'published');
      allow create: if hasCapability('announcements.manage')
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.status == 'published'
        && request.resource.data.priority in ['normal', 'important', 'urgent']
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if hasCapability('announcements.manage')
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }

    function validGoogleDocumentUrl(value) {
      return value is string
        && value.matches('^https://(docs|drive|sheets|slides)[.]google[.]com/.*$');
    }

    function validDocumentAccess(data) {
      return data.accessScope in ['board', 'officers', 'restricted', 'founder']
        && data.allowedDirectorUids is list
        && data.allowedDirectorUids.size() <= 25
        && (
          (data.accessScope == 'restricted' && data.allowedDirectorUids.size() > 0)
          || (data.accessScope != 'restricted' && data.allowedDirectorUids.size() == 0)
        );
    }

    function canReadDocumentData(data) {
      return founderDirector()
        || (activeDirector() && data.submittedBy == request.auth.uid)
        || (hasCapability('documents.review') && data.accessScope != 'founder')
        || (
          hasCapability('documents.view')
          && (
            data.accessScope == 'board'
            || (data.accessScope == 'officers' && isOfficer())
            || (data.accessScope == 'restricted' && request.auth.uid in data.allowedDirectorUids)
          )
        );
    }

    function validNewDocument() {
      return hasCapability('documents.submit')
        && request.resource.data.documentNumber is string
        && request.resource.data.title is string
        && request.resource.data.description is string
        && validGoogleDocumentUrl(request.resource.data.documentUrl)
        && request.resource.data.linkType is string
        && request.resource.data.category in [
          'governance', 'policy', 'financial', 'program', 'committee',
          'report', 'legal', 'minutes', 'other'
        ]
        && request.resource.data.status == 'submitted'
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.revisionNumber == 1
        && request.resource.data.lastEventId is string
        && !exists(documentEventPath(request.resource.data.lastEventId))
        && request.resource.data.submittedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validDocumentAccess(request.resource.data);
    }

    function submitterMayReviseDocument() {
      return activeDirector()
        && resource.data.submittedBy == request.auth.uid
        && resource.data.status in ['submitted', 'returned_for_revision']
        && request.resource.data.submittedBy == resource.data.submittedBy
        && request.resource.data.documentNumber == resource.data.documentNumber
        && request.resource.data.accessScope == resource.data.accessScope
        && request.resource.data.allowedDirectorUids == resource.data.allowedDirectorUids
        && request.resource.data.category == resource.data.category
        && validGoogleDocumentUrl(request.resource.data.documentUrl)
        && request.resource.data.status == 'submitted'
        && request.resource.data.revisionNumber == resource.data.revisionNumber + 1
        && request.resource.data.lastEventId is string
        && request.resource.data.lastEventId != resource.data.lastEventId
        && !exists(documentEventPath(request.resource.data.lastEventId))
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'description', 'documentUrl', 'linkType', 'requestedAction',
          'status', 'revisionNumber', 'reviewNote', 'reviewedBy',
          'reviewedByName', 'reviewedAt', 'lastEventId', 'updatedAt', 'updatedBy'
        ]);
    }

    function validReviewTransition() {
      return (
          resource.data.status == 'submitted'
          && request.resource.data.status in ['under_review', 'returned_for_revision', 'agenda_ready', 'rejected', 'tabled', 'archived']
        ) || (
          resource.data.status == 'under_review'
          && request.resource.data.status in ['returned_for_revision', 'agenda_ready', 'approved', 'rejected', 'tabled', 'archived']
        ) || (
          resource.data.status == 'returned_for_revision'
          && request.resource.data.status == 'archived'
        ) || (
          resource.data.status == 'agenda_ready'
          && request.resource.data.status in ['approved', 'rejected', 'tabled', 'archived']
        ) || (
          resource.data.status in ['approved', 'rejected', 'tabled']
          && request.resource.data.status == 'archived'
        );
    }

    function reviewerMayUpdateDocument() {
      return hasCapability('documents.review')
        && resource.data.accessScope != 'founder'
        && validReviewTransition()
        && request.resource.data.submittedBy == resource.data.submittedBy
        && request.resource.data.documentNumber == resource.data.documentNumber
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.accessScope == resource.data.accessScope
        && request.resource.data.allowedDirectorUids == resource.data.allowedDirectorUids
        && request.resource.data.category == resource.data.category
        && request.resource.data.lastEventId is string
        && request.resource.data.lastEventId != resource.data.lastEventId
        && !exists(documentEventPath(request.resource.data.lastEventId))
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewNote', 'reviewedBy', 'reviewedByName',
          'reviewedAt', 'archivedAt', 'lastEventId', 'updatedAt', 'updatedBy'
        ]);
    }

    function founderMayReviewFounderOnlyDocument() {
      return founderDirector()
        && resource.data.accessScope == 'founder'
        && validReviewTransition()
        && request.resource.data.submittedBy == resource.data.submittedBy
        && request.resource.data.documentNumber == resource.data.documentNumber
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.accessScope == resource.data.accessScope
        && request.resource.data.allowedDirectorUids == resource.data.allowedDirectorUids
        && request.resource.data.category == resource.data.category
        && request.resource.data.lastEventId is string
        && request.resource.data.lastEventId != resource.data.lastEventId
        && !exists(documentEventPath(request.resource.data.lastEventId))
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewNote', 'reviewedBy', 'reviewedByName',
          'reviewedAt', 'archivedAt', 'lastEventId', 'updatedAt', 'updatedBy'
        ]);
    }

    match /documents/{documentId} {
      allow get, list: if canReadDocumentData(resource.data);
      allow create: if validNewDocument();
      allow update: if submitterMayReviseDocument()
        || reviewerMayUpdateDocument()
        || founderMayReviewFounderOnlyDocument();
      allow delete: if false;
    }

    function documentBefore(documentId) {
      return get(/databases/$(database)/documents/documents/$(documentId)).data;
    }

    function documentAfter(documentId) {
      return getAfter(/databases/$(database)/documents/documents/$(documentId)).data;
    }

    function validSubmittedDocumentEvent(eventId) {
      return eventId == documentAfter(request.resource.data.documentId).lastEventId
        && request.resource.data.type == 'submitted'
        && documentAfter(request.resource.data.documentId).submittedBy == request.auth.uid
        && documentAfter(request.resource.data.documentId).status == 'submitted'
        && documentAfter(request.resource.data.documentId).revisionNumber == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdAt == documentAfter(request.resource.data.documentId).createdAt;
    }

    function validRevisionDocumentEvent(eventId) {
      return eventId == documentAfter(request.resource.data.documentId).lastEventId
        && request.resource.data.type in ['revised', 'resubmitted']
        && documentBefore(request.resource.data.documentId).submittedBy == request.auth.uid
        && documentAfter(request.resource.data.documentId).submittedBy == request.auth.uid
        && documentAfter(request.resource.data.documentId).status == 'submitted'
        && documentAfter(request.resource.data.documentId).revisionNumber == documentBefore(request.resource.data.documentId).revisionNumber + 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdAt == documentAfter(request.resource.data.documentId).updatedAt
        && (
          (request.resource.data.type == 'resubmitted' && documentBefore(request.resource.data.documentId).status == 'returned_for_revision')
          || (request.resource.data.type == 'revised' && documentBefore(request.resource.data.documentId).status == 'submitted')
        );
    }

    function validReviewDocumentEvent(eventId) {
      return eventId == documentAfter(request.resource.data.documentId).lastEventId
        && request.resource.data.type in ['under_review', 'returned_for_revision', 'agenda_ready', 'approved', 'rejected', 'tabled', 'archived']
        && documentAfter(request.resource.data.documentId).status == request.resource.data.type
        && documentAfter(request.resource.data.documentId).reviewedBy == request.auth.uid
        && documentBefore(request.resource.data.documentId).status != documentAfter(request.resource.data.documentId).status
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdAt == documentAfter(request.resource.data.documentId).updatedAt
        && (
          founderDirector()
          || (hasCapability('documents.review') && documentBefore(request.resource.data.documentId).accessScope != 'founder')
        );
    }

    match /documentEvents/{eventId} {
      allow get, list: if signedIn()
        && resource.data.documentId is string
        && canReadDocumentData(documentBefore(resource.data.documentId));
      allow create: if activeDirector()
        && request.resource.data.documentId is string
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.type is string
        && canReadDocumentData(documentAfter(request.resource.data.documentId))
        && (
          validSubmittedDocumentEvent(eventId)
          || validRevisionDocumentEvent(eventId)
          || validReviewDocumentEvent(eventId)
        );
      allow update, delete: if false;
    }

    function validMeetingCreate() {
      return hasCapability('meetings.create')
        && request.resource.data.meetingNumber is string
        && request.resource.data.title is string
        && request.resource.data.meetingType in ['regular', 'special', 'organizational', 'emergency']
        && request.resource.data.scheduledFor is string
        && request.resource.data.locationMode in ['in_person', 'virtual', 'hybrid']
        && request.resource.data.status == 'scheduled'
        && request.resource.data.invitedDirectorUids is list
        && request.resource.data.invitedDirectorUids.size() > 0
        && request.resource.data.invitedDirectorUids.size() <= 100
        && request.resource.data.eligibleVotingDirectorUids is list
        && request.resource.data.invitedDirectorUids.hasAll(request.resource.data.eligibleVotingDirectorUids)
        && request.resource.data.quorumRequired is int
        && request.resource.data.quorumRequired > 0
        && request.resource.data.quorumRequired <= request.resource.data.eligibleVotingDirectorUids.size()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validMeetingActivation() {
      return hasCapability('meetings.activate')
        && resource.data.status == 'scheduled'
        && request.resource.data.status == 'checkin_open'
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.checkInOpenedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'checkInOpenedAt', 'updatedAt', 'updatedBy'
        ]);
    }

    function validMeetingControl() {
      return hasCapability('meetings.control')
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && (
          (
            resource.data.status == 'scheduled'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.cancelledAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'updatedAt', 'updatedBy'])
          ) || (
            resource.data.status == 'checkin_open'
            && request.resource.data.status == 'in_session'
            && request.resource.data.calledToOrderAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'calledToOrderAt', 'updatedAt', 'updatedBy'])
          ) || (
            resource.data.status == 'checkin_open'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.cancelledAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'updatedAt', 'updatedBy'])
          ) || (
            resource.data.status == 'in_session'
            && request.resource.data.status == 'recessed'
            && request.resource.data.recessedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'recessedAt', 'updatedAt', 'updatedBy'])
          ) || (
            resource.data.status == 'recessed'
            && request.resource.data.status == 'in_session'
            && request.resource.data.resumedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resumedAt', 'updatedAt', 'updatedBy'])
          ) || (
            resource.data.status in ['in_session', 'recessed']
            && request.resource.data.status == 'adjourned'
            && request.resource.data.adjournedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'adjournedAt', 'updatedAt', 'updatedBy'])
          )
        );
    }

    match /meetings/{meetingId} {
      allow get, list: if hasCapability('meetings.view');
      allow create: if validMeetingCreate();
      allow update: if validMeetingActivation() || validMeetingControl();
      allow delete: if false;
    }

    function meetingAfter(meetingId) {
      return getAfter(/databases/$(database)/documents/meetings/$(meetingId)).data;
    }

    function meetingCurrent(meetingId) {
      return get(/databases/$(database)/documents/meetings/$(meetingId)).data;
    }

    function validAttendanceCreate(attendanceId) {
      return hasCapability('meetings.create')
        && request.resource.data.meetingId is string
        && request.resource.data.directorUid is string
        && attendanceId == request.resource.data.meetingId + '_' + request.resource.data.directorUid
        && meetingAfter(request.resource.data.meetingId).createdBy == request.auth.uid
        && meetingAfter(request.resource.data.meetingId).status == 'scheduled'
        && request.resource.data.directorUid in meetingAfter(request.resource.data.meetingId).invitedDirectorUids
        && request.resource.data.votingEligible == (request.resource.data.directorUid in meetingAfter(request.resource.data.meetingId).eligibleVotingDirectorUids)
        && request.resource.data.presenceStatus == 'invited'
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function selfMayCheckIn() {
      return activeDirector()
        && resource.data.directorUid == request.auth.uid
        && meetingCurrent(resource.data.meetingId).status in ['checkin_open', 'in_session', 'recessed']
        && resource.data.presenceStatus in ['invited', 'departed']
        && request.resource.data.presenceStatus == 'present'
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastPresenceChangeAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'presenceStatus', 'checkedInAt', 'returnedAt', 'lastPresenceChangeAt', 'updatedAt', 'updatedBy'
        ])
        && (
          (resource.data.checkedInAt == null && request.resource.data.checkedInAt == request.time)
          || (resource.data.checkedInAt != null && request.resource.data.checkedInAt == resource.data.checkedInAt && request.resource.data.returnedAt == request.time)
        );
    }

    function attendanceManagerMayUpdate() {
      return hasCapability('meetings.attendance.manage')
        && meetingCurrent(resource.data.meetingId).status in ['scheduled', 'checkin_open', 'in_session', 'recessed']
        && request.resource.data.meetingId == resource.data.meetingId
        && request.resource.data.directorUid == resource.data.directorUid
        && request.resource.data.directorNumber == resource.data.directorNumber
        && request.resource.data.directorName == resource.data.directorName
        && request.resource.data.votingEligible == resource.data.votingEligible
        && request.resource.data.invited == resource.data.invited
        && request.resource.data.presenceStatus in ['invited', 'present', 'departed', 'excused', 'absent']
        && (
          request.resource.data.presenceStatus in ['invited', 'excused']
          || meetingCurrent(resource.data.meetingId).status in ['checkin_open', 'in_session', 'recessed']
        )
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastPresenceChangeAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'presenceStatus', 'checkedInAt', 'departedAt', 'returnedAt', 'excusedAt', 'absentAt',
          'lastPresenceChangeAt', 'updatedAt', 'updatedBy'
        ])
        && (
          request.resource.data.presenceStatus == 'invited'
          || (request.resource.data.presenceStatus == 'departed' && request.resource.data.departedAt == request.time)
          || (request.resource.data.presenceStatus == 'excused' && request.resource.data.excusedAt == request.time)
          || (request.resource.data.presenceStatus == 'absent' && request.resource.data.absentAt == request.time)
          || (
            request.resource.data.presenceStatus == 'present'
            && (
              (resource.data.checkedInAt == null && request.resource.data.checkedInAt == request.time)
              || (resource.data.checkedInAt != null && request.resource.data.checkedInAt == resource.data.checkedInAt && request.resource.data.returnedAt == request.time)
            )
          )
        );
    }

    match /meetingAttendance/{attendanceId} {
      allow get, list: if hasCapability('meetings.view');
      allow create: if validAttendanceCreate(attendanceId);
      allow update: if selfMayCheckIn() || attendanceManagerMayUpdate();
      allow delete: if false;
    }

    match /system/{systemDocument} {
      allow read, create, update: if founderDirector();
      allow delete: if false;
    }

    match /auditEvents/{eventId} {
      allow get, list: if founderDirector();
      allow create: if founderDirector()
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Phase 1-5 use direct reads or one equality/array-contains filter.
    // No manual/composite Firestore indexes are defined or deployed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
