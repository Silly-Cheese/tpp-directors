        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time && request.resource.data.certified == false
        && voteAfter(request.resource.data.voteId).status == 'closed' && voteAfter(request.resource.data.voteId).resolutionId == id
