        && request.resource.data.complianceNumber is string
        && request.resource.data.title is string
        && request.resource.data.category in ['corporate','tax','registration','policy','board','financial','program','other']
        && request.resource.data.status in ['pending','due','completed','waived']
        && optionalGoogleUrl(request.resource.data.sourceDocumentUrl)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow update: if cap('compliance.manage')
        && request.resource.data.complianceNumber == resource.data.complianceNumber
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.category in ['corporate','tax','registration','policy','board','financial','program','other']
        && request.resource.data.status in ['pending','due','completed','waived']
        && optionalGoogleUrl(request.resource.data.sourceDocumentUrl)
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    function governanceManager() {
      return founder() || cap('committees.manage') || cap('coi.review') || cap('coi.manage')
        || cap('officers.manage') || cap('tasks.manage') || cap('compliance.manage');
    }
    function governanceWriter() {
      return governanceManager() || cap('coi.submit') || cap('tasks.create') || cap('tasks.updateOwn');
    }
    match /governanceEvents/{id} {
      allow get, list: if governanceManager();
      allow create: if governanceWriter()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.category in ['committee','coi','officer','task','compliance']
        && request.resource.data.action is string
        && request.resource.data.targetType is string
        && request.resource.data.targetId is string
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /activationVault/{id} {
      allow get, list, create, update: if founder();
      allow delete: if false;
    }

    match /system/{id} {
      allow read, update: if founder();
      allow create: if founder() || founderBootstrapCounter(id);
      allow delete: if false;
    }
    match /auditEvents/{id} {
      allow get, list: if founder() || cap('audit.view');
      allow create: if founder() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Phases 1-8 intentionally define no manual/composite indexes.
    match /{document=**} { allow read, write: if false; }
  }
}
