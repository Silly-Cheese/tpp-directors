        && vote(request.resource.data.voteId).status == 'open' && request.auth.uid in vote(request.resource.data.voteId).eligibleVoterUids
        && request.resource.data.meetingId == vote(request.resource.data.voteId).meetingId && presentVoter(request.resource.data.meetingId, request.auth.uid)
